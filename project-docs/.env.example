# Local development only. Copy to .env; never commit real values.

NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sports_booking
POSTGRES_USER=booking_app
POSTGRES_PASSWORD=booking_dev_password
DATABASE_URL=postgresql://booking_app:booking_dev_password@localhost:5432/sports_booking

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://booking_app:booking_dev_password@localhost:5672/booking

JWT_ACCESS_SECRET=replace-for-local-development
JWT_REFRESH_PEPPER=replace-for-local-development

# Provider adapter remains undecided for V1.
PAYMENT_PROVIDER=local_dev_stub
PAYMENT_WEBHOOK_SECRET=replace-for-local-development

SMTP_HOST=localhost
SMTP_PORT=1025
SMS_PROVIDER=local_dev_stub
